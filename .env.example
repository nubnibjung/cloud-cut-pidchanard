# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cloudcut:cloudcut@localhost:5432/cloudcut
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
API_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads

# ── Pusher (optional — collaboration real-time events) ────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_POLL_MS=1000
WORKER_OUTPUT_DIR=./tmp/exports

# ── Frontend (Vite) — copy to frontend/.env.local ────────────────────────────
VITE_API_BASE=http://localhost:8080
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1

# Cloudflare R2 for uploads and exports (optional; leave unset to store files in ./uploads)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Export height in pixels (default 1080; 720 suits a 512 MB server)
# EXPORT_HEIGHT=720
